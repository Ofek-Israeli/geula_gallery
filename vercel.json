{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "installCommand": "npm ci",
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then npm run db:migrate && { [ \"$SETUP_ON_BUILD\" != 1 ] || sh scripts/production-setup.sh; } && npm run build; else npm run build; fi",
  "crons": [
    { "path": "/api/cron/purge", "schedule": "30 2 * * *" },
    { "path": "/api/cron/outbox", "schedule": "0 3 * * *" },
    { "path": "/api/cron/reconcile", "schedule": "30 3 * * *" },
    { "path": "/api/cron/tracking", "schedule": "0 4 * * *" },
    { "path": "/api/cron/daily", "schedule": "0 5 * * *" }
  ]
}
