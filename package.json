{
  "name": "geula-gallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:secrets": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-secrets.ts",
    "test": "vitest run --project unit --project contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/test-e2e.ts",
    "verify": "npm run lint && npm run typecheck && npm run check:secrets && npm test && npm run test:integration",
    "verify:all": "npm run verify && npm run build && npm run test:e2e",
    "db:setup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/db-setup.ts",
    "db:generate": "node --conditions=react-server ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "db:reset": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/db-reset.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed/index.ts",
    "auth:generate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/auth-generate.ts",
    "admin:create": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/admin-create.ts",
    "env:init": "node --import tsx scripts/env-init.ts",
    "demo:fetch-images": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/fetch-demo-images.ts",
    "gen:api-types": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/gen-api-types.ts",
    "cron": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/cron.ts",
    "check:cardcom": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-cardcom.ts",
    "check:paypal": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-paypal.ts",
    "check:morning": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-morning.ts",
    "check:dhl": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-dhl.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@react-pdf/renderer": "4.9.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0",
    "resend": "6.31.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "use-intl": "4.14.8",
    "yet-another-react-lightbox": "3.32.2",
    "zod": "4.6.5"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
