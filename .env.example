# Geula Gallery environment variables (spec §4.8).
# PLACEHOLDERS ONLY. Never put real values in this file; it is committed to a public repo.
# For local development run `npm run env:init`, which writes .env.local with generated secrets.
# Validated at boot by src/server/env.ts (zod + cross-field rules). Production values: docs/deploy.md §5.
# Empty values count as unset. PUBLIC_WEBHOOK_BASE_URL, BETTER_AUTH_URL and DATABASE_URL_UNPOOLED are
# derived when unset; leave them unset unless they must differ.

# ---------------------------------------------------------------- Core
# development | test | production (never use NODE_ENV for policy)
APP_ENV=development
APP_URL=http://localhost:3000
# Optional; defaults to APP_URL. Leave unset unless webhooks must reach a tunnel URL.
# PUBLIC_WEBHOOK_BASE_URL=
# >= 32 bytes, e.g. `openssl rand -base64url 32`
APP_SECRET=placeholder-generate-a-32-byte-secret
# base64 of exactly 32 random bytes (AES-256-GCM for cancellation ID numbers), e.g. `openssl rand -base64 32`.
# Back it up: encrypted ID numbers cannot be read without it.
PII_ENCRYPTION_KEY=placeholder-base64-32-bytes
# true: demo banner, noindex everywhere, no live provider allowed
DEMO_MODE=true
# Optional build output dir (worktrees / E2E use .next-<name>)
# NEXT_DIST_DIR=.next

# ---------------------------------------------------------------- Database
DATABASE_URL=postgres://USER@localhost:5432/geula_dev
# Optional; defaults to DATABASE_URL (Neon: the unpooled URL for migrations)
# DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=postgres://USER@localhost:5432/geula_test
E2E_DATABASE_URL=postgres://USER@localhost:5432/geula_e2e
E2E_PORT=3100
# Playwright only: reuse a server already listening on E2E_PORT (local iteration)
# E2E_REUSE_SERVER=1

# ---------------------------------------------------------------- Auth
BETTER_AUTH_SECRET=placeholder-generate-a-32-byte-secret
# Optional; defaults to APP_URL
# BETTER_AUTH_URL=
# Forced to true when APP_URL is https or APP_ENV=production
ADMIN_REQUIRE_2FA=false
ADMIN_EMAIL=painter@example.com
# Scripts only (admin:create). Never printed.
ADMIN_PASSWORD=placeholder-at-least-12-characters
# Seeds the E2E admin users (Playwright sets this; keep false elsewhere)
SEED_E2E_USERS=false
# Optional E2E admin password for the seed (defaults to an e2e- value)
# E2E_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Abuse controls
# 1 in production (enforced); E2E uses 100
RATE_LIMIT_SCALE=1
# >= 3000 in production (enforced); E2E uses 0
FORM_MIN_AGE_MS=3000

# ---------------------------------------------------------------- Cron
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`; >= 32 characters in production
CRON_SECRET=placeholder-generate-a-32-byte-secret

# ---------------------------------------------------------------- Payments
# Comma list, in display order: mock,cardcom,paypal
PAYMENT_PROVIDERS=mock
# HMAC key for the mock provider's webhooks (>= 32 characters in production)
MOCK_WEBHOOK_SECRET=placeholder-generate-a-32-byte-secret
# direct | capture
MOCK_PAYMENT_FLOW=direct

# ---------------------------------------------------------------- Cardcom (LowProfile v11)
# disabled | test | live. Terminal values go only in .env.local / Vercel, never here.
# The public test terminal is currently refused (HTTP 401, ResponseCode 603): ask Cardcom for a test terminal.
# `npm run env:init` can write them from CARDCOM_TEST_TERMINAL_NUMBER / CARDCOM_TEST_API_NAME (shell only).
CARDCOM_MODE=disabled
CARDCOM_BASE_URL=https://secure.cardcom.solutions
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
# Required for live mode (refunds, ListTransactions sweep)
CARDCOM_API_PASSWORD=
# Comma list: ILS,USD
CARDCOM_CURRENCIES=ILS
# Enabled | Disabled | Auto
CARDCOM_3DS=Enabled
# Comma list of wallets configured on the terminal: bit,applepay,googlepay
CARDCOM_WALLETS=
CARDCOM_LATE_WATCH_HOURS=72
CARDCOM_TAIL_DAYS=30

# ---------------------------------------------------------------- PayPal (Orders v2, full-page redirect)
# disabled | sandbox | live
PAYPAL_MODE=disabled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered for /api/payments/paypal/webhook; without it every webhook is rejected
PAYPAL_WEBHOOK_ID=
# Required when enabled: payments to any other payee are refused (`npm run check:paypal` prints it)
PAYPAL_MERCHANT_ID=

# ---------------------------------------------------------------- Tax documents
# mock | morning | gateway | none (production: morning or gateway; gateway requires CARDCOM_MODE=live)
TAX_DOCUMENTS_MODE=mock
# disabled | sandbox | live
MORNING_MODE=disabled
MORNING_CLIENT_ID=
MORNING_CLIENT_SECRET=

# ---------------------------------------------------------------- Shipping
# mock | manual | dhl (dhl requires DHL_EXPRESS_MODE != disabled)
SHIPPING_CARRIER=mock
# disabled | test | live
DHL_EXPRESS_MODE=disabled
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
# true only if the DHL account has paperless trade (PLT)
DHL_PAPERLESS_TRADE=false
# Optional override for gen:api-types
# DHL_OPENAPI_URL=
# Mock carrier: seconds from label to DELIVERED (E2E uses 1)
MOCK_CARRIER_DELIVERY_SECONDS=300

# ---------------------------------------------------------------- Email
# log (stored in email_messages) | resend (production)
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=Geula Gallery <studio@example.com>
# EMAIL_REPLY_TO=studio@example.com

# ---------------------------------------------------------------- Storage
# local (.data/uploads/{public,private}) | blob (production: a public and a private store)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# Public store token
BLOB_READ_WRITE_TOKEN=
# Private store token
BLOB_PRIVATE_READ_WRITE_TOKEN=
# Public store host, e.g. abc123.public.blob.vercel-storage.com (inlined at build time; used by next/image and the CSP)
NEXT_PUBLIC_BLOB_HOST=

# ---------------------------------------------------------------- Demo
# Sent to the Art Institute of Chicago API by `npm run demo:fetch-images`
AIC_USER_AGENT=geula-gallery-demo (https://github.com/Ofek-Israeli/geula_gallery)

# ---------------------------------------------------------------- Opt-in live checks (never in verify)
# Set these in the shell for one run (e.g. `CARDCOM_CONTRACT=1 npm run test:contract`), not here.
# RECORD_FIXTURES=1 lets the check scripts overwrite redacted fixtures.
CARDCOM_CONTRACT=
PAYPAL_CONTRACT=
MORNING_CONTRACT=
DHL_CONTRACT=
RECORD_FIXTURES=
